#!/bin/sh
# install — remote one-command installer for the llm-wiki-nano skill.
#
# NOTE: deliberate exception to the repo's "no code" prime directive,
# granted by the repo owner. POSIX sh + curl/wget + tar only.
#
# Usage (nothing to clone first) — run it from your project root:
#   curl -fsSL https://raw.githubusercontent.com/longkerdandy/llm-wiki-nano/main/install | bash
#   curl -fsSL ... | bash -s -- [--global] [--claude]
#
# Default: installs into .agents/skills/ of the current directory (project
# level), scanned natively by Kimi Code, GitHub Copilot CLI, Codex, and
# other agents following the Agent Skills standard.
# --global installs into ~/.agents/skills/ (user level) instead.
# --claude additionally copies into .claude/skills/ (or ~/.claude/skills/
# with --global) for Claude Code, which does not scan .agents/skills/.
set -eu

NAME=llm-wiki-nano
# Override for testing/mirrors:
REPO="${LLM_WIKI_NANO_REPO:-longkerdandy/llm-wiki-nano}"
TARBALL="${LLM_WIKI_NANO_TARBALL:-https://codeload.github.com/$REPO/tar.gz/main}"

usage() {
    cat <<'EOF'
usage: curl -fsSL https://raw.githubusercontent.com/longkerdandy/llm-wiki-nano/main/install | bash [-s -- [--global] [--claude]]

Installs the llm-wiki-nano skill into .agents/skills/ of the current
directory (run it from your project root). Options:

  --global    install into ~/.agents/skills/ instead (user level)
  --claude    also copy into .claude/skills/ for Claude Code
  -h, --help  show this help
EOF
}

root=$PWD
claude=false
for arg in "$@"; do
    case "$arg" in
        --global)   root=$HOME ;;
        --claude)   claude=true ;;
        -h|--help)  usage; exit 0 ;;
        *)          usage >&2; exit 1 ;;
    esac
done

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
echo "fetching $TARBALL"
if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$TARBALL" -o "$TMP/repo.tar.gz"
elif command -v wget >/dev/null 2>&1; then
    wget -q "$TARBALL" -O "$TMP/repo.tar.gz"
else
    echo "error: curl or wget is required" >&2
    exit 1
fi
mkdir -p "$TMP/repo"
tar -xzf "$TMP/repo.tar.gz" -C "$TMP/repo" --strip-components=1
[ -f "$TMP/repo/SKILL.md" ] || { echo "error: tarball did not contain SKILL.md" >&2; exit 1; }
new_version=$(sed -n '/^---$/,/^---$/{s/^version:[[:space:]]*//p;}' "$TMP/repo/SKILL.md" | head -n 1)

dests="$root/.agents/skills/$NAME"
if [ "$claude" = true ]; then
    dests="$dests $root/.claude/skills/$NAME"
fi
for dest in $dests; do
    if [ -f "$dest/SKILL.md" ]; then
        old_version=$(sed -n '/^---$/,/^---$/{s/^version:[[:space:]]*//p;}' "$dest/SKILL.md" | head -n 1)
        case "$old_version" in
            "")               echo "upgrading: unversioned -> $new_version" ;;
            "$new_version")   echo "reinstalling: $new_version" ;;
            *)                echo "upgrading: $old_version -> $new_version" ;;
        esac
    fi
    rm -rf "$dest"
    mkdir -p "$dest"
    cp -R "$TMP/repo/SKILL.md" "$TMP/repo/resources" "$dest/"
    echo "installed: $dest"
done

echo "done. Start a new agent session to pick up the skill."
